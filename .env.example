# Example Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.

# PORT=3000
# OPENAI_API_KEY=
# GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Port for the API server (the Vite client runs on 5173 and proxies /api here)
# API_PORT=3001

# Set to 1 to run without an API key (canned fake responses, for UI work)
MOCK=0
