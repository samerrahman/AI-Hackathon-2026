# Stu uses only StepFun for live text and voice. Configure the STEPFUN entries below.
# Legacy Google settings are retained for compatibility but are ignored by Stu.
GEMINI_API_KEY=
# Legacy model setting, ignored.
GEMINI_MODEL=gemini-3.8-flash

# Legacy OpenAI audio settings, ignored. No OpenAI key or balance is needed.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Optional stable, private encryption secret for resumable challenge state.
# If blank, Stu generates and stores a local key in .miso/state-key. Keep that key to resume sessions.
SESSION_SECRET=
PORT=3001
STUDY_PROVIDER=stepfun
VOICE_PROVIDER=stepfun
# Legacy Groq settings, ignored. No Groq key or balance is needed.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
GROQ_API_KEY=
# Active text and voice configuration. Keep this key on the server only.
STEPFUN_MODEL=step-3.7-flash
STEPFUN_BASE_URL=https://api.stepfun.ai/v1
STEPFUN_API_KEY=
STEPFUN_TRANSCRIBE_MODEL=stepaudio-3-asr-max
STEPFUN_TTS_MODEL=stepaudio-3-tts
STEPFUN_TTS_VOICE=vibrant-youth
STEPFUN_AUDIO_LANGUAGE=en

STEPFUN_REASONING_EFFORT=low
