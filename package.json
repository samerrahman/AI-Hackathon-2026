{
  "name": "teach-stu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/dev.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "build:hosting": "tsc --noEmit && vite build --mode hosting",
    "build:functions": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=functions/lib/app.mjs",
    "start": "tsx server/dev.ts",
    "test": "node --import tsx --test server/*.test.ts src/lib/*.test.ts",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@types/multer": "^2.3.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "idb-keyval": "^6.2.2",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
