{
  "functions": {
    "source": "functions",
    "codebase": "api",
    "predeploy": ["npm run build:functions"]
  },
  "hosting": {
    "site": "ai-la-hackathon-2026",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
