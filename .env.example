# Live text study: create an API key in Google AI Studio and keep it here on the server.
GEMINI_API_KEY=
# Configurable model, documented for structured JSON output. Account access must be checked live.
GEMINI_MODEL=gemini-2.5-flash

# Optional real transcription and AI-generated speech. Typed study works without this.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Optional stable, private encryption secret for resumable challenge state.
# If blank, Miso generates and stores a local key in .miso/state-key. Keep that key to resume sessions.
SESSION_SECRET=
PORT=3001
