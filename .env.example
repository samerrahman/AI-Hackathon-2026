# Example Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.

# PORT=3000
# OPENAI_API_KEY=

# Which AI runs the judge and Stu: anthropic | gemini | asi1
# (if unset, picks gemini or asi1 when only that key is present, else anthropic)
LLM_PROVIDER=gemini

# Google Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Fetch.ai ASI:One: key at https://asi1.ai
ASI_ONE_API_KEY=
# ASI_MODEL=asi1

# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Port for the API server (the Vite client runs on 5173 and proxies /api here)
# API_PORT=3001

# Set to 1 to run without any API key (canned fake responses, for UI work)
MOCK=0
