# Server-side only. Leave blank to use deterministic demo mode.
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/v1
STEPFUN_MODEL=step-5-preview
STEPFUN_STU_MODEL=step-3.7-flash
# Optional voice, using the same key. VOICE_PROVIDER=off disables it.
VOICE_PROVIDER=stepfun
STEPFUN_TRANSCRIBE_MODEL=stepaudio-3-asr-max
STEPFUN_TTS_MODEL=stepaudio-3-tts
STEPFUN_TTS_VOICE=vibrant-youth
STEPFUN_AUDIO_LANGUAGE=en
STEPFUN_TIMEOUT_MS=75000
# Keep this stable across server restarts and deployments.
SESSION_SECRET=
DEMO_MODE=true

# --- Teach Stu ASI:One agent (agent/) ---
# ASI_ONE_API_KEY=          # asi1.ai -> API keys. Used for Stu, and for the judge if no Anthropic key.
# ASI:One defaults: judge asi1, Stu asi1-mini (asi1-ultra also available)
# ANTHROPIC_API_KEY=        # optional: judge (rubric + grading) runs on Claude when set
# JUDGE_PROVIDER= / STU_PROVIDER=   # asi1 | anthropic;  JUDGE_MODEL= / STU_MODEL= to override
# AGENT_SEED=               # unique secret -> stable Agentverse address. CHANGE THIS.
# AGENT_NAME=teach-stu
# AGENT_PORT=8001
# MOCK=1                    # run with a fake judge + Stu, no keys
