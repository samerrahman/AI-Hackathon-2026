# Server-side only. Leave blank to use deterministic demo mode.
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/v1
STEPFUN_MODEL=step-5-preview
STEPFUN_STU_MODEL=step-3.7-flash
# Optional voice, using the same key. VOICE_PROVIDER=off disables it.
VOICE_PROVIDER=stepfun
STEPFUN_TRANSCRIBE_MODEL=stepaudio-3-asr-max
STEPFUN_TTS_MODEL=stepaudio-3-tts
STEPFUN_TTS_VOICE=vibrant-youth
STEPFUN_AUDIO_LANGUAGE=en
# StepFun reasoning effort (low | medium | high). Higher is slower; each call must finish within its timeout.
STEPFUN_RUBRIC_REASONING_EFFORT=low
STEPFUN_JUDGE_REASONING_EFFORT=low
STEPFUN_STU_REASONING_EFFORT=low
# Per-call limits (ms). Judge + 2 × Stu must stay under Vercel's 180 s request limit.
STEPFUN_RUBRIC_TIMEOUT_MS=150000
STEPFUN_JUDGE_TIMEOUT_MS=100000
STEPFUN_STU_TIMEOUT_MS=35000
# Keep this stable across server restarts and deployments.
SESSION_SECRET=
DEMO_MODE=true
